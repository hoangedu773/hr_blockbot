PORT=3001
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority
ATLAS_URI=
JWT_SECRET=your_jwt_secret_min_32_chars_replace_in_production
ACCESS_TOKEN_TTL=15m
FRONTEND_URL=http://localhost:5173
NODE_ENV=development
AI_SERVICE_URL=http://localhost:8000
# Required when a shared AI service calls back to multiple APIs with distinct JWT secrets.
# Must exactly match a server-side allowed origin on the AI service.
AUTHORIZATION_SELF_ORIGIN=http://localhost:3001
# >= 32 ký tự, KHÔNG commit. Dùng để suy ra mật khẩu tạm theo quy luật (scripts/provision-accounts.mjs passwords).
# Mất secret = phải cấp lại mật khẩu toàn bộ nhân viên.
ACCOUNT_PASSWORD_SECRET=

# Optional decision notarization. Leave blank until a registry is deployed on
# the chosen EVM chain. No server private key: registrar signs in their wallet.
ASSIGNMENT_CHAIN_RPC_URL=
ASSIGNMENT_CHAIN_ID=
ASSIGNMENT_REGISTRY_ADDRESS=
ASSIGNMENT_CHAIN_CONFIRMATIONS=1
