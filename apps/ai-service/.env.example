PORT=8000
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/hr_bot?retryWrites=true&w=majority
API_BACKEND_URL=http://localhost:3001
AI_AGENT_ENABLED=false
# Required. Empty => every /api/v1 request is rejected with 503 (fail-closed).
# Must match AI_SERVICE_API_KEY in apps/api.
AI_SERVICE_API_KEY=

# Typed decision gate (ADR-019). Order of precedence in JevGateway.decide():
#   1. JEV_API_KEY      -> thejevai.com /v1/systemone (single synchronous call)
#   2. JEV_USEJEVAI_KEYS -> usejevai.com queued run API, rotating trial accounts
#   3. neither           -> JSON-forced LLM fallback (degraded, not Jev)
# Single key (leave empty if you use the rotating pool):
JEV_API_KEY=
JEV_MODEL=typesafe/jev-1.14
# Comma-separated trial keys; dead keys are disabled, rate-limited keys cool down.
JEV_USEJEVAI_KEYS=
JEV_USEJEVAI_BASE_URL=https://usejevai.com
JEV_USEJEVAI_TIMEOUT_MS=15000
JEV_USEJEVAI_COOLDOWN_SECONDS=60
