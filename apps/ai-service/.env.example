PORT=8000
# V1 runtime has no MongoDB credentials or direct legacy tool access.
AUTHORIZATION_API_ORIGIN=http://localhost:3001
# Required. Empty => every /api/v1 request is rejected with 503 (fail-closed).
# Must match AI_SERVICE_API_KEY in apps/api.
AI_SERVICE_API_KEY=

# Authorization V1: OFF is default. SHADOW is synthetic-only. LIVE is opt-in and
# calls the real TheJevAI System One endpoint after scoped API preflight.
# LIVE requires BOTH JEV_V1_MODE=LIVE and JEV_LIVE_ALLOW_EXTERNAL_TEXT=true.
JEV_V1_MODE=OFF
JEV_LIVE_ALLOW_EXTERNAL_TEXT=false

# Jev System One credentials for the opt-in V1 LIVE adapter and legacy lane.
# Never commit these values or send HR text without explicit authorization.
JEV_API_KEY=
JEV_MODEL=typesafe/jev-1.14
# Comma-separated trial keys; dead keys are disabled, rate-limited keys cool down.
JEV_USEJEVAI_KEYS=
JEV_USEJEVAI_BASE_URL=https://usejevai.com
JEV_USEJEVAI_TIMEOUT_MS=15000
JEV_USEJEVAI_COOLDOWN_SECONDS=60
