{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "HR BlockBot - Scalable Production RAG Architecture",
    "visual_preset": "signal-flow",
    "theme": "dark",
    "animation": "trace",
    "views": [
      {
        "id": "chap-1",
        "title": "1. Ingress & Realtime WebSocket Interface",
        "narrative": "Nhân viên gửi tin nhắn qua React ChatPanel (6 trạng thái). Express API quản lý xác thực JWT, kết nối Socket.IO thời gian thực.",
        "focus_nodes": ["web-chat", "api-gateway"]
      },
      {
        "id": "chap-2",
        "title": "2. Intent Routing & Hybrid Retrieval",
        "narrative": "FastAPI sidecar điều hướng ý định: hỏi chính sách chuyển tới Hybrid Retrieval (Atlas Vector Search kết hợp BM25 Lexical fallback).",
        "focus_nodes": ["ai-router", "ai-retrieval", "ai-embedder", "db-policies"]
      },
      {
        "id": "chap-3",
        "title": "3. Grounded Generation & Citation Guardrails",
        "narrative": "Sinh câu trả lời có trích dẫn điều khoản cụ thể. Tự động từ chối (Abstain) khi tài liệu không đủ bằng chứng tin cậy.",
        "focus_nodes": ["ai-answer", "ext-llm", "api-gateway", "web-chat"]
      },
      {
        "id": "chap-4",
        "title": "4. Runtime Provider Switching & Storage",
        "narrative": "Admin cấu hình provider qua giao diện, mã hóa AES-256-GCM zero-leak. Lịch sử chat lưu trữ trong MongoDB với trần 50 tin.",
        "focus_nodes": ["web-admin", "api-crypto", "db-settings", "db-conversations"]
      }
    ]
  },
  "boundaries": [
    {
